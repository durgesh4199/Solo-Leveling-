{
  "appId": "com.huntersguild.hunterprotocol",
  "productName": "Hunter Protocol",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true
  },
  "linux": {
    "target": ["AppImage"],
    "category": "Game"
  },
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.games"
  }
}
